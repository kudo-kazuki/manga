{
    "name": "manga-infra",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build:frontend": "npm --prefix ../frontend run build",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test test/manga-stack.test.ts",
        "synth": "npm run build:frontend && cdk synth",
        "diff": "npm run build:frontend && cdk diff",
        "deploy": "npm run build:frontend && cdk deploy"
    },
    "dependencies": {
        "aws-cdk-lib": "^2.270.0",
        "constructs": "^10.8.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "aws-cdk": "^2.1142.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
