{
    "name": "novels",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=24.18.0"
    },
    "scripts": {
        "dev": "vite --host",
        "dev:deploy-console": "node ./scripts/dev-deploy-console.mjs",
        "deploy:backend": "node ./scripts/deploy-backend-lambdas.mjs",
        "deploy:frontend": "node ./scripts/deploy-frontend.mjs",
        "type-check": "vue-tsc -b",
        "build": "vue-tsc -b && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "preview": "vite preview"
    },
    "dependencies": {
        "@vueuse/core": "^14.3.0",
        "animate.css": "^4.1.1",
        "axios": "^1.16.0",
        "dayjs": "^1.11.20",
        "element-plus": "^2.14.3",
        "marked": "^18.0.6",
        "pinia": "^3.0.4",
        "pinia-plugin-persistedstate": "^4.7.1",
        "vue": "^3.5.39",
        "vue-router": "^5.2.0"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.9.1",
        "playwright": "^1.63.0",
        "prettier": "^3.8.3",
        "sass": "^1.99.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.64.0",
        "unplugin-auto-import": "^21.0.0",
        "unplugin-vue-components": "^32.0.0",
        "vite": "^8.1.3",
        "vite-plugin-pages": "^0.33.3",
        "vitest": "^5.0.1",
        "vue-tsc": "^3.3.7"
    }
}
